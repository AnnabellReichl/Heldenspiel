public class Monster
{
    private int angriffswert;
    private int lebenspunkte = 10;

    public Monster()
    {
        angriffswert = ((Math.random()*30)+1);
    }

    public int getAngriffswert()
    {
        return angriffswert;
    }

    public int getLebenspunkte()
    {
        return lebenspunkte;
    }
}
